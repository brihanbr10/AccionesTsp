@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AppDbContext DbContext

@using ActividadApp.Data

@if (isReady)
{
    <div class="page">
        <header class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/home">ActividadApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/acciones">Acciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/reportes">Reportes</a>
                        </li>
                        @if (esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear me-1"></i>Maestros
                                </a>
                                <ul class="dropdown-menu">
                                    <li><h6 class="dropdown-header">Tablas Maestras</h6></li>
                                    <li><a class="dropdown-item" href="/maestros/origen"><i class="bi bi-tag me-2"></i>Origenes</a></li>
                                    <li><a class="dropdown-item" href="/maestros/entidad"><i class="bi bi-building me-2"></i>Entidades</a></li>
                                    <li><a class="dropdown-item" href="/maestros/sisgestion"><i class="bi bi-shield-check me-2"></i>Sistemas de Gestion</a></li>
                                    <li><a class="dropdown-item" href="/maestros/organizacion"><i class="bi bi-diagram-2 me-2"></i>Organizaciones</a></li>
                                    <li><a class="dropdown-item" href="/maestros/sitio"><i class="bi bi-geo-alt me-2"></i>Sitios</a></li>
                                    <li><a class="dropdown-item" href="/maestros/cargo"><i class="bi bi-briefcase me-2"></i>Cargos</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Procesos</h6></li>
                                    <li><a class="dropdown-item" href="/maestros/responsables"><i class="bi bi-people me-2"></i>Responsables de Proceso</a></li>
                                    <li><a class="dropdown-item" href="/maestros/procesos"><i class="bi bi-diagram-3 me-2"></i>Procesos</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="bi bi-person-circle"></i> @username
                                @if (esAdmin)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Admin</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-outline-light" @onclick="HandleSignOut">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesion
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="container mt-4">
            @Body
        </main>
    </div>
}

@code {
    private bool isReady;
    private string? username;
    private bool esAdmin = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            username = authState.User.Identity?.Name;

            var session = await AuthService.GetCurrentUserSession();
            if (session != null)
            {
                var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Id == session.UserId);
                esAdmin = user?.RolId == 2;
            }

            isReady = true;
            StateHasChanged();
        }
    }

    private async Task HandleSignOut()
    {
        await AuthService.SignOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
