@page "/maestros/procesos"
@rendermode InteractiveServer

@inject AppDbContext DbContext
@inject AuthService AuthService
@inject NavigationManager Navigation

@using ActividadApp.Data
@using ActividadApp.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Procesos</PageTitle>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-diagram-3 me-2"></i>Procesos</h2>
    </div>

    @if (!esAdmin)
    {
        <div class="alert alert-danger">No tiene permisos para acceder a esta seccion.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
                <i class="bi @(esError ? "bi-exclamation-circle" : "bi-check-circle") me-2"></i>@mensaje
                <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
            </div>
        }

        <!-- Formulario -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-5">
                        <label class="form-label">Descripcion</label>
                        <input type="text" class="form-control" placeholder="Nombre del proceso..." @bind="nuevaDescripcion" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Responsable</label>
                        <select class="form-select" @bind="nuevoResponsableId">
                            <option value="0">Seleccionar...</option>
                            @foreach (var r in responsables)
                            {
                                <option value="@r.Id">@r.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        @if (editandoId.HasValue)
                        {
                            <button class="btn btn-warning me-2" @onclick="Actualizar">
                                <i class="bi bi-pencil me-1"></i>Actualizar
                            </button>
                            <button class="btn btn-secondary" @onclick="CancelarEdicion">Cancelar</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="Crear"
                                    disabled="@(string.IsNullOrWhiteSpace(nuevaDescripcion) || nuevoResponsableId == 0)">
                                <i class="bi bi-plus-circle me-1"></i>Agregar
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!procesos.Any())
        {
            <div class="alert alert-info">No hay procesos registrados.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:80px">ID</th>
                                <th>Proceso</th>
                                <th>Responsable</th>
                                <th style="width:150px" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in procesos)
                            {
                                <tr>
                                    <td>@p.Id</td>
                                    <td>@p.Descripcion</td>
                                    <td>@(p.Responsable?.Nombre ?? "-")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => IniciarEdicion(p)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(p.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Proceso> procesos = new();
    private List<ResponsableProceso> responsables = new();

    private string nuevaDescripcion = string.Empty;
    private int nuevoResponsableId = 0;
    private int? editandoId = null;
    private bool isLoading = true;
    private bool esAdmin = false;
    private string mensaje = string.Empty;
    private bool esError = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var session = await AuthService.GetCurrentUserSession();
            if (session == null) { Navigation.NavigateTo("/login"); return; }

            var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Id == session.UserId);
            esAdmin = user?.RolId == 2;

            if (esAdmin)
            {
                responsables = await DbContext.ResponsablesProceso.OrderBy(r => r.Nombre).ToListAsync();
                await CargarDatos();
            }

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        procesos = await DbContext.Procesos
            .Include(p => p.Responsable)
            .OrderBy(p => p.Descripcion)
            .ToListAsync();
    }

    private async Task Crear()
    {
        if (string.IsNullOrWhiteSpace(nuevaDescripcion) || nuevoResponsableId == 0) return;

        DbContext.Procesos.Add(new Proceso
        {
            Descripcion = nuevaDescripcion.Trim(),
            ResponsableId = nuevoResponsableId
        });
        await DbContext.SaveChangesAsync();

        nuevaDescripcion = string.Empty;
        nuevoResponsableId = 0;
        mensaje = "Proceso creado correctamente.";
        esError = false;
        await CargarDatos();
    }

    private void IniciarEdicion(Proceso p)
    {
        editandoId = p.Id;
        nuevaDescripcion = p.Descripcion;
        nuevoResponsableId = p.ResponsableId;
    }

    private void CancelarEdicion()
    {
        editandoId = null;
        nuevaDescripcion = string.Empty;
        nuevoResponsableId = 0;
    }

    private async Task Actualizar()
    {
        if (!editandoId.HasValue) return;

        var proceso = await DbContext.Procesos.FindAsync(editandoId.Value);
        if (proceso != null)
        {
            proceso.Descripcion = nuevaDescripcion.Trim();
            proceso.ResponsableId = nuevoResponsableId;
            await DbContext.SaveChangesAsync();

            mensaje = "Proceso actualizado correctamente.";
            esError = false;
        }

        CancelarEdicion();
        await CargarDatos();
    }

    private async Task Eliminar(int id)
    {
        try
        {
            var proceso = await DbContext.Procesos.FindAsync(id);
            if (proceso != null)
            {
                DbContext.Procesos.Remove(proceso);
                await DbContext.SaveChangesAsync();
                mensaje = "Proceso eliminado correctamente.";
                esError = false;
                await CargarDatos();
            }
        }
        catch
        {
            mensaje = "No se puede eliminar: el proceso esta siendo usado por una accion.";
            esError = true;
        }
    }
}
