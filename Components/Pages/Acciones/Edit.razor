                            else
                            {
                                <p class="text-muted fst-italic mb-0"><i class="bi bi-inbox me-1"></i>Sin observaciones registradas aún.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }


        @if (tieneSolucionGuardada)
        {
        <!-- SECCION 3: Confirmación del Plan de Acción -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clipboard-check me-2"></i>3. Confirmación del Plan de Acción</span>
                @if (todasActividadesEjecutadas || tieneConfirmacionGuardada)
                {
                    <div class="form-check form-switch mb-0">
