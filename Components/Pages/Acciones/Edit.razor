                            <div class="col-md-3 mb-3">
                                <label class="form-label">Cumplió el Plan</label>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" @bind="confirmacion.CumplioPlan" />
