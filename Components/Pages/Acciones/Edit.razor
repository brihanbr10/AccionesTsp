                            <textarea class="form-control" @bind="eficacia.Comentarios" rows="3"></textarea>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="fechaEficacia" min="@fechaCompromiso.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Responsable <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="eficacia.ResponsableId">
                                <option value="0">Seleccionar...</option>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Id">@u.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Resultado</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" @bind="eficacia.Eficaz" />
                                <label class="form-check-label">@(eficacia.Eficaz ? "Eficaz" : "No Eficaz")</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        }

        <!-- Boton Guardar -->
        <div class="d-flex gap-2 mb-5">
            <button type="button" class="btn btn-warning btn-lg" @onclick="HandleSubmit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Actualizando...</span>
                }
                else
                {
                    <i class="bi bi-check-circle me-1"></i>
                    <span>Actualizar Accion</span>
                }
            </button>
            <a href="/acciones" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    }
</div>

<!-- Modal confirmacion ejecutada -->
@if (showConfirmEjecutada)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="CancelarConfirmacionEjecutada"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de finalizar esta tarea?</p>
                    <p class="text-muted small mb-3">Esta acción no se puede deshacer.</p>
                    
                    <div class="mb-3">
                        <label class="form-label">Comentario de ejecución <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" @bind="comentarioEjecucion" 
                                  placeholder="Describa cómo se ejecutó la actividad..."></textarea>
                        <small class="text-muted">Este comentario es obligatorio para documentar la ejecución.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarConfirmacionEjecutada">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarEjecutada">
                        <i class="bi bi-check-circle me-1"></i>Si, finalizar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ResultModal? resultModal;
    private bool showConfirmEjecutada = false;
    private int? actividadIndexConfirm = null;
    private string comentarioEjecucion = string.Empty;

    private UserSession? userSession;
    private Accion? accion;
    private Solucion solucion = new();
    private ConfirmacionPlanAccion confirmacion = new();
    private Eficacia eficacia = new();
    private List<Actividad> actividades = new();
    private List<SeguimientoSgi> seguimientosSgi = new();

    private DateTime fecha = DateTime.UtcNow;
    private DateTime fechaInvestigacion = DateTime.UtcNow;
    private DateTime fechaCompromiso = DateTime.UtcNow;
    private DateTime fechaConfirmacion = DateTime.UtcNow;
    private DateTime fechaEficacia = DateTime.UtcNow;

    private bool incluirSolucion = false;
    private bool incluirConfirmacion = false;
    private bool incluirEficacia = false;
    private bool mostrarSeguimientoSgi = false;
    private bool esAdmin = false;
    private bool esInvestigador = false;
    private string nuevoComentarioSgi = string.Empty;

    private Dictionary<int, List<SeguimientoActividad>> seguimientosActividades = new();
    private Dictionary<int, string> nuevosComentariosActividad = new();
    private Dictionary<int, bool> isLoadingActividad = new();
    private int? actividadExpandidaIndex = null;

    private bool tieneSolucionGuardada = false;
    private bool tieneConfirmacionGuardada = false;
    private int estadoAnterior = 0;

    private bool todasActividadesEjecutadas => actividades.Any() && actividades.All(a => a.Ejecutada);

    private bool puedeEditarActividades => !tieneConfirmacionGuardada && (esAdmin || esInvestigador || !tieneSolucionGuardada);

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool isLoadingSgi = false;
    private bool isLoadingData = true;

    private string? username;
    private string nombreResponsable = string.Empty;

    // Dropdowns
    private List<Maestro> origenes = new();
    private List<Maestro> entidades = new();
    private List<Maestro> sistemasGestion = new();
    private List<Maestro> organizaciones = new();
    private List<Maestro> sitios = new();
    private List<Proceso> procesos = new();
    private List<Usuario> usuarios = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userSession = await AuthService.GetCurrentUserSession();
            if (userSession != null)
            {
                username = userSession.Username;
                var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Id == userSession.UserId);
                esAdmin = user?.RolId == 2;
            }

            origenes = await DbContext.Maestros.AsNoTracking().Where(m => m.Tipo == TipoMaestro.ORIGEN).ToListAsync();
            entidades = await DbContext.Maestros.AsNoTracking().Where(m => m.Tipo == TipoMaestro.ENTIDAD).ToListAsync();
            sistemasGestion = await DbContext.Maestros.AsNoTracking().Where(m => m.Tipo == TipoMaestro.SISGESTION).ToListAsync();
            organizaciones = await DbContext.Maestros.AsNoTracking().Where(m => m.Tipo == TipoMaestro.ORGANIZACION).ToListAsync();
            sitios = await DbContext.Maestros.AsNoTracking().Where(m => m.Tipo == TipoMaestro.SITIO).ToListAsync();
            procesos = await DbContext.Procesos.AsNoTracking().Include(p => p.Responsable).ToListAsync();
            usuarios = await DbContext.Users.AsNoTracking().Include(u => u.Agencia).ToListAsync();

            await LoadAccion();

            StateHasChanged();
        }
    }

    private async Task LoadAccion()
    {
        isLoadingData = true;
        accion = await AccionService.GetById(Id);

        if (accion != null)
        {
            fecha = accion.Fecha;
            estadoAnterior = accion.EstadoId;

            // Precargar seguimientos SGI
            seguimientosSgi = accion.SeguimientosSgi ?? new();

            // Precargar responsable del proceso
            var proceso = procesos.FirstOrDefault(p => p.Id == accion.ProcesoId);
            if (proceso?.Responsable != null)
            {
                nombreResponsable = proceso.Responsable.Nombre;
            }

            // Precargar solucion
            if (accion.Solucion != null)
            {
                incluirSolucion = true;
                tieneSolucionGuardada = true;
                solucion = accion.Solucion;
                fechaInvestigacion = solucion.FechaInvestigacion;
                fechaCompromiso = solucion.FechaCompromiso;
                actividades = solucion.Actividades ?? new();

                // Cargar seguimientos de cada actividad
                for (int i = 0; i < actividades.Count; i++)
                {
                    var act = actividades[i];
                    nuevosComentariosActividad[i] = string.Empty;

                    if (act.Id > 0)
                    {
                        var seguimientos = await DbContext.SeguimientosActividades
                            .Where(s => s.ActividadId == act.Id)
                            .Include(s => s.Usuario)
                            .OrderByDescending(s => s.Fecha)
                            .ToListAsync();
                        seguimientosActividades[act.Id] = seguimientos;
                    }
                }
            }

            // Precargar confirmacion
            if (accion.ConfirmacionPlanAccion != null)
            {
                incluirConfirmacion = true;
                tieneConfirmacionGuardada = true;
                confirmacion = accion.ConfirmacionPlanAccion;
                fechaConfirmacion = confirmacion.Fecha;
            }

            // Precargar eficacia
            if (accion.Eficacia != null)
            {
                incluirEficacia = true;
                eficacia = accion.Eficacia;
                fechaEficacia = eficacia.Fecha;
            }
        }

        isLoadingData = false;
    }

    private void AgregarActividad()
    {
        actividades.Add(new Actividad { Fecha = DateTime.UtcNow });
    }

    private void EliminarActividad(int index)
    {
        actividades.RemoveAt(index);
    }

    private void OnResponsableActividadChanged(int index)
    {
        if (index >= 0 && index < actividades.Count)
        {
            var actividad = actividades[index];
            if (actividad.ResponsableId > 0)
            {
                var usuario = usuarios.FirstOrDefault(u => u.Id == actividad.ResponsableId);
                if (usuario?.Agencia != null)
                {
                    actividad.Agencia = usuario.Agencia.Descripcion;
                }
            }
            else
            {
                actividad.Agencia = string.Empty;
            }
        }
    }

    private void SolicitarConfirmacionEjecutada(int index)
    {
        if (actividades[index].Ejecutada) return;
        actividadIndexConfirm = index;
        comentarioEjecucion = string.Empty; // Limpiar comentario
        showConfirmEjecutada = true;
    }

    private async Task ConfirmarEjecutada()
    {
        if (!actividadIndexConfirm.HasValue) return;

        // Validar que el comentario no esté vacío
        if (string.IsNullOrWhiteSpace(comentarioEjecucion))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debe ingresar un comentario para documentar la ejecución de la actividad.");
            return;
        }

        var act = actividades[actividadIndexConfirm.Value];
        if (act.FechaEjecucion == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debe indicar la fecha de ejecución antes de finalizar la tarea.");
            return;
        }

        try
        {
            // Marcar actividad como ejecutada
            act.Ejecutada = true;

            // Crear seguimiento de actividad con el comentario
            var seguimiento = new SeguimientoActividad
            {
                ActividadId = act.Id,
                UsuarioId = userSession.UserId,
                Fecha = DateTime.UtcNow,
                Comentario = comentarioEjecucion.Trim()
            };

            DbContext.SeguimientosActividades.Add(seguimiento);
            await DbContext.SaveChangesAsync();

            // Recargar seguimientos para mostrar el nuevo comentario
            var seguimientos = await DbContext.SeguimientosActividades
                .Where(s => s.ActividadId == act.Id)
                .Include(s => s.Usuario)
                .OrderByDescending(s => s.Fecha)
                .ToListAsync();
            seguimientosActividades[act.Id] = seguimientos;

            successMessage = "Actividad finalizada correctamente con comentario registrado.";
            await Task.Delay(3000);
            successMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al finalizar la actividad: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            showConfirmEjecutada = false;
            actividadIndexConfirm = null;
            comentarioEjecucion = string.Empty;
        }
    }

    private void CancelarConfirmacionEjecutada()
    {
        showConfirmEjecutada = false;
        actividadIndexConfirm = null;
        comentarioEjecucion = string.Empty;
    }

    private async Task AgregarSeguimientoSgi()
    {
        if (string.IsNullOrWhiteSpace(nuevoComentarioSgi) || accion == null || userSession == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "El campo de comentario no puede estar vacío.");
            return;
        }
        if (isLoadingSgi) return; // Protección contra doble clic

        isLoadingSgi = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
         {
             // Usar siempre los días seleccionados actualmente
             var seguimiento = new SeguimientoSgi
             {
                 AccionId = accion.Id,
                 UsuarioId = userSession.UserId,
                 Fecha = DateTime.UtcNow,
                 Comentario = nuevoComentarioSgi.Trim()
             };

             DbContext.SeguimientosSgi.Add(seguimiento);
             await DbContext.SaveChangesAsync();

            nuevoComentarioSgi = string.Empty;
            errorMessage = string.Empty;
            successMessage = "Observación agregada correctamente.";

            // Recargar seguimientos desde la base de datos para sincronizar
            seguimientosSgi = await DbContext.SeguimientosSgi
                .Where(s => s.AccionId == accion.Id)
                .Include(s => s.Usuario)
                .OrderByDescending(s => s.Fecha)
                .ToListAsync();

            StateHasChanged();

            // Limpiar mensaje después de 3 segundos
            await Task.Delay(3000);
            successMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al agregar observación: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isLoadingSgi = false;
        }
    }

    private async Task AgregarSeguimientoActividad(int actividadId, int actividadIndex)
    {
        if (!nuevosComentariosActividad.ContainsKey(actividadIndex) || 
            string.IsNullOrWhiteSpace(nuevosComentariosActividad[actividadIndex]) || 
            userSession == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "El campo de observación no puede estar vacío.");
            return;
        }
        if (isLoadingActividad.ContainsKey(actividadIndex) && isLoadingActividad[actividadIndex]) return; // Protección contra doble clic

        if (!isLoadingActividad.ContainsKey(actividadIndex))
        {
            isLoadingActividad[actividadIndex] = false;
        }

        isLoadingActividad[actividadIndex] = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            var seguimiento = new SeguimientoActividad
            {
                ActividadId = actividadId,
                UsuarioId = userSession.UserId,
                Fecha = DateTime.UtcNow,
                Comentario = nuevosComentariosActividad[actividadIndex].Trim()
            };

            DbContext.SeguimientosActividades.Add(seguimiento);
            await DbContext.SaveChangesAsync();

            nuevosComentariosActividad[actividadIndex] = string.Empty;
            errorMessage = string.Empty;
            successMessage = "Observación agregada correctamente.";

            // Recargar seguimientos desde la base de datos para sincronizar
            var seguimientos = await DbContext.SeguimientosActividades
                .Where(s => s.ActividadId == actividadId)
                // No incluir en el seguimiento el dato del usuario
                .Include(s => s.Usuario)
                .OrderByDescending(s => s.Fecha)
                .ToListAsync();
            seguimientosActividades[actividadId] = seguimientos;

            StateHasChanged();

            // Limpiar mensaje después de 3 segundos
            await Task.Delay(3000);
            successMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al agregar observación: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isLoadingActividad[actividadIndex] = false;
        }
    }

    private void ToggleSeguimientosActividad(int index)
    {
        actividadExpandidaIndex = actividadExpandidaIndex == index ? null : index;
    }

    private List<SeguimientoActividad> ObtenerSeguimientosActividad(int actividadId)
    {
        return seguimientosActividades.ContainsKey(actividadId) ? seguimientosActividades[actividadId] : new();
    }

    private int? uploadingIndex = null;

    private async Task SubirEvidencia(InputFileChangeEventArgs e, int index)
    {
        var archivo = e.File;
        if (archivo == null || accion == null) return;

        const long maxSize = 10 * 1024 * 1024; // 10 MB
        if (archivo.Size > maxSize)
        {
            errorMessage = "El archivo no debe superar los 10 MB.";
            return;
        }

        uploadingIndex = index;
        StateHasChanged();

        try
        {
            using var stream = archivo.OpenReadStream(maxSize);
            var (ruta, nombre) = await FileService.GuardarArchivo(stream, archivo.Name, accion.Id, actividades[index].Id);
            actividades[index].RutaEvidencia = ruta;
            actividades[index].NombreArchivoEvidencia = nombre;
        }
        catch
        {
            errorMessage = "Error al subir el archivo. Intente nuevamente.";
        }
        finally
        {
            uploadingIndex = null;
            StateHasChanged();
        }
    }

    private void EliminarEvidencia(int index)
    {
        var act = actividades[index];
        if (!string.IsNullOrEmpty(act.RutaEvidencia))
        {
            FileService.EliminarArchivo(act.RutaEvidencia);
            act.RutaEvidencia = null;
            act.NombreArchivoEvidencia = null;
        }
    }

    private string NombreMaestro(List<Maestro> lista, int id) =>
        lista.FirstOrDefault(m => m.Id == id)?.Descripcion ?? "-";

    private string TipoAccionTexto => accion?.TipoAccionId switch
    {
        1 => "Preventiva",
        2 => "Correctiva",
        3 => "Mejora",
        _ => "-"
    };

    private string NombreProceso =>
        procesos.FirstOrDefault(p => p.Id == (accion?.ProcesoId ?? 0))?.Descripcion ?? "-";

    private string NombreUsuario(int usuarioId) =>
        usuarios.FirstOrDefault(u => u.Id == usuarioId)?.Nombre ?? "-";

    private async Task HandleSubmit()
    {
        if (accion == null) return;

        errorMessage = string.Empty;
        successMessage = string.Empty;
        isLoading = true;

        try
        {
            accion.UpdatedAt = DateTime.UtcNow;

            if (incluirSolucion && !tieneSolucionGuardada)
            {
                if (string.IsNullOrWhiteSpace(solucion.AnalisisCausa) ||
                    string.IsNullOrWhiteSpace(solucion.CorreccionPropuesta) ||
                    solucion.UsuarioInvestigaId == 0 || solucion.UsuarioCoordinaId == 0)
                {
                    await resultModal.ShowError("Validación", "Todos los campos de la solución son requeridos.");
                    isLoading = false;
                    return;
                }

                if (actividades.Any(a => string.IsNullOrWhiteSpace(a.Descripcion) || a.ResponsableId == 0))
                {
                    await resultModal.ShowError("Validación", "Cada actividad debe tener descripción y responsable.");
                    isLoading = false;
                    return;
                }
            }

            if (incluirSolucion && tieneSolucionGuardada && !tieneConfirmacionGuardada)
            {
                var sinFecha = actividades.Where(a => a.Ejecutada && a.FechaEjecucion == null).ToList();
                if (sinFecha.Any())
                {
                    await resultModal.ShowError("Validación", "Las actividades ejecutadas deben tener fecha de ejecución.");
                    isLoading = false;
                    return;
                }
            }

            if (incluirSolucion)
            {
                solucion.FechaInvestigacion = fechaInvestigacion;
                solucion.FechaCompromiso = fechaCompromiso;
                solucion.Actividades = actividades;
                accion.Solucion = solucion;
            }

            if (incluirSolucion && incluirConfirmacion && !tieneConfirmacionGuardada)
            {
                if (string.IsNullOrWhiteSpace(confirmacion.DetallesCumplimiento) ||
                    confirmacion.ResponsableId == 0 ||
                    confirmacion.DiasParaVerificar <= 0)
                {
                    await resultModal.ShowError("Validación", "Todos los campos de la confirmación son requeridos.");
                    isLoading = false;
                    return;
                }
            }

            if (incluirSolucion && incluirConfirmacion)
            {
                confirmacion.Fecha = fechaConfirmacion;
                accion.ConfirmacionPlanAccion = confirmacion;
            }

            if (tieneConfirmacionGuardada && incluirEficacia)
            {
                if (string.IsNullOrWhiteSpace(eficacia.Comentarios) ||
                    eficacia.ResponsableId == 0)
                {
                    await resultModal.ShowError("Validación", "Todos los campos de eficacia son requeridos.");
                    isLoading = false;
                    return;
                }

                eficacia.Fecha = fechaEficacia;
                accion.Eficacia = eficacia;
            }

            accion.EstadoId = AccionService.CalcularEstadoId(accion);

            var success = await AccionService.Update(accion);

            if (success)
            {
                var consecutivo = $"{accion.Id:D4}";
                var proceso = procesos.FirstOrDefault(p => p.Id == accion.ProcesoId);
                var nuevoEstado = accion.EstadoId;

                // Solucion nueva: correo a responsables de actividades
                if (nuevoEstado >= 2 && estadoAnterior < 2 && actividades.Any())
                {
                    foreach (var act in actividades.Where(a => a.ResponsableId > 0))
                    {
                        var usuario = usuarios.FirstOrDefault(u => u.Id == act.ResponsableId);
                        if (usuario != null)
                        {
                            await EmailService.EnviarSolucionRegistrada(
                                usuario.Email, usuario.Nombre,
                                consecutivo, proceso?.Descripcion ?? "-",
                                act.Descripcion, act.Agencia, solucion.FechaCompromiso);
                        }
                    }
                }

                // Confirmacion pendiente: correo al investigador
                if (nuevoEstado >= 3 && estadoAnterior < 3 && solucion.UsuarioInvestigaId > 0)
                {
                    var investigador = usuarios.FirstOrDefault(u => u.Id == solucion.UsuarioInvestigaId);
                    if (investigador != null)
                    {
                        await EmailService.EnviarConfirmacionPendiente(
                            investigador.Email, investigador.Nombre,
                            consecutivo, proceso?.Descripcion ?? "-", accion.Descripcion);
                    }
                }

                // Confirmacion hecha: correo a administradores para eficacia
                if (nuevoEstado == 4 && estadoAnterior < 4)
                {
                    var admins = usuarios.Where(u => u.RolId == 2).ToList();
                    foreach (var admin in admins)
                    {
                        await EmailService.EnviarEficaciaPendiente(
                            admin.Email, admin.Nombre,
                            consecutivo, proceso?.Descripcion ?? "-", accion.Descripcion);
                    }
                }

                // Eficacia registrada: correo al responsable del proceso
                if (nuevoEstado == 5 && estadoAnterior < 5 && proceso?.Responsable != null)
                {
                    await EmailService.EnviarAccionCerrada(
                        proceso.Responsable.Email, proceso.Responsable.Nombre,
                        consecutivo, proceso.Descripcion, accion.Descripcion, eficacia.Eficaz);
                }

                await resultModal.ShowSuccess(
                    "Acción Actualizada",
                    "Los cambios han sido guardados correctamente.",
                    $"ID: {consecutivo}"
                );
            }
            else
            {
                await resultModal.ShowError("Error", "Error al actualizar la acción. Por favor, intenta nuevamente.");
            }
        }
        catch (Exception ex) when (ex.GetType().Name == "NavigationException")
        {
            // Permite que Blazor realice la redireccion
            throw;
        }
        catch (Exception ex)
        {
            await resultModal.ShowError("Error Inesperado", "Ocurrió un error inesperado.", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ValidarFechas()
    {
        if (fechaCompromiso.Date < fechaInvestigacion.Date)
        {
            await JSRuntime.InvokeVoidAsync("alert", "La fecha de compromiso no puede ser menor a la fecha de investigacion.");
            fechaCompromiso = fechaInvestigacion;
            StateHasChanged();
        }
    }

    private async Task ValidarFechaActividad(int index)
    {
        if (index >= 0 && index < actividades.Count)
        {
            var act = actividades[index];
            if (act.Fecha.Date < fechaInvestigacion.Date || act.Fecha.Date > fechaCompromiso.Date)
            {
                await JSRuntime.InvokeVoidAsync("alert", "La fecha de la actividad debe estar entre la fecha de investigacion y la fecha de compromiso.");
                act.Fecha = fechaCompromiso;
                StateHasChanged();
            }
        }
    }
}
