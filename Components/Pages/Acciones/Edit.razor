@page "/acciones/edit/{Id:int}"
@inject AccionService AccionService
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AppDbContext DbContext
@inject IEmailService EmailService
@inject IFileService FileService
@inject IJSRuntime JSRuntime
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using ActividadApp.Data
@using ActividadApp.Models
@using ActividadApp.Services
@using ActividadApp.Services.Email
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

<PageTitle>Editar Acción</PageTitle>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Editar Acción</h2>
        <a href="/acciones" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>

    @if (isLoadingData)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando acción...</p>
        </div>
    }
    else if (accion == null)
    {
        <div class="alert alert-danger">
            No se encontró la acción solicitada.
        </div>
        <a href="/acciones" class="btn btn-secondary">Volver</a>
    }
    else
    {
        <ResultModal @ref="resultModal" />

        <!-- SECCION 1: Información General (Solo lectura) -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-info-circle me-2"></i>1. Información General
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Persona que reporta</label>
                        <input type="text" class="form-control" value="@(accion.Usuario?.Username ?? username)" readonly />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Fecha</label>
                        <input type="text" class="form-control" value="@accion.Fecha.ToString("dd/MM/yyyy")" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Tipo de Acción</label>
                        <input type="text" class="form-control" value="@TipoAccionTexto" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Organización</label>
                        <input type="text" class="form-control" value="@NombreMaestro(organizaciones, accion.OrganizacionId)" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Origen</label>
                        <input type="text" class="form-control" value="@NombreMaestro(origenes, accion.OrigenId)" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Proceso</label>
                        <input type="text" class="form-control" value="@NombreProceso" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Responsable del Proceso</label>
                        <input type="text" class="form-control" value="@nombreResponsable" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Entidad</label>
                        <input type="text" class="form-control" value="@NombreMaestro(entidades, accion.EntidadId)" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Sistema de Gestión</label>
                        <input type="text" class="form-control" value="@NombreMaestro(sistemasGestion, accion.SistemaGestionId)" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Sitio</label>
                        <input type="text" class="form-control" value="@NombreMaestro(sitios, accion.SitioId)" readonly />
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Descripción del hallazgo</label>
                        <textarea class="form-control" rows="3" readonly>@accion.Descripcion</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECCION 2: Solucion -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-lightbulb me-2"></i>2. Solucion</span>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" @bind="incluirSolucion" />
                    <label class="form-check-label text-white">Incluir</label>
                </div>
            </div>
            @if (incluirSolucion)
            {
                <div class="card-body">
                    @if (tieneSolucionGuardada)
                    {
                        <!-- Campos de solo lectura cuando la solucion ya existe -->
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Investigador</label>
                                <input type="text" class="form-control" value="@NombreUsuario(solucion.UsuarioInvestigaId)" readonly />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Fecha Investigación</label>
                                <input type="text" class="form-control" value="@solucion.FechaInvestigacion.ToString("dd/MM/yyyy")" readonly />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Coordinador</label>
                                <input type="text" class="form-control" value="@NombreUsuario(solucion.UsuarioCoordinaId)" readonly />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Fecha Compromiso</label>
                                <input type="text" class="form-control" value="@solucion.FechaCompromiso.ToString("dd/MM/yyyy")" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Corrección Propuesta</label>
                                <textarea class="form-control" rows="3" readonly>@solucion.CorreccionPropuesta</textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Análisis de Causa o Propósito de mejora</label>
                                <textarea class="form-control" rows="3" readonly>@solucion.AnalisisCausa</textarea>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Campos editables cuando es nueva solucion -->
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Investigador <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="solucion.UsuarioInvestigaId">
                                    <option value="0">Seleccionar...</option>
                                    @foreach (var u in usuarios)
                                    {
                                        <option value="@u.Id">@u.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Fecha Investigación <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="fechaInvestigacion" @bind:after="ValidarFechas" min="@accion.Fecha.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Coordinador <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="solucion.UsuarioCoordinaId">
                                    <option value="0">Seleccionar...</option>
                                    @foreach (var u in usuarios)
                                    {
                                        <option value="@u.Id">@u.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Fecha Compromiso <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="fechaCompromiso" @bind:after="ValidarFechas" min="@fechaInvestigacion.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Corrección Propuesta <span class="text-danger">*</span></label>
                                <textarea class="form-control" @bind="solucion.CorreccionPropuesta" rows="3"></textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Análisis de Causa o Propósito de mejora <span class="text-danger">*</span></label>
                                <textarea class="form-control" @bind="solucion.AnalisisCausa" rows="3"></textarea>
                            </div>
                        </div>
                    }

                    <!-- Actividades del Plan -->
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0"><i class="bi bi-list-task me-1"></i>Actividades del Plan</h6>
                        @if (puedeEditarActividades)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="AgregarActividad">
                                <i class="bi bi-plus-circle me-1"></i>Agregar
                            </button>
                        }
                    </div>
                    @if (actividades.Any())
                    {
                        @if (tieneSolucionGuardada && !tieneConfirmacionGuardada)
                        {
                            <!-- Modo tabla: para actividades nuevas (sin ID) -->
                            <div class="table-responsive mb-4">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Descripción</th>
                                            <th>Responsable</th>
                                            <th>Agencia</th>
                                            <th>Fecha</th>
                                            <th>Observaciones</th>
                                            <th style="width:60px"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < actividades.Count; i++)
                                        {
                                            var index = i;
                                            @if (actividades[index].Id == 0)
                                            {
                                                <tr>
                                                    <td><input class="form-control form-control-sm" @bind="actividades[index].Descripcion" /></td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="actividades[index].ResponsableId" @bind:after="() => OnResponsableActividadChanged(index)">
                                                            <option value="0">Seleccionar...</option>
                                                            @foreach (var u in usuarios)
                                                            {
                                                                <option value="@u.Id">@u.Nombre</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><input class="form-control form-control-sm" @bind="actividades[index].Agencia" readonly /></td>
                                                    <td><input type="date" class="form-control form-control-sm" @bind="actividades[index].Fecha" @bind:after="() => ValidarFechaActividad(index)" min="@fechaInvestigacion.ToString("yyyy-MM-dd")" max="@fechaCompromiso.ToString("yyyy-MM-dd")" /></td>
                                                    <td><textarea class="form-control form-control-sm" rows="2" @bind="actividades[index].Observaciones" placeholder="Observaciones..."></textarea></td>
                                                    <td>
                                                        @if (puedeEditarActividades)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarActividad(index)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Modo tarjetas: para actividades guardadas (con ID) -->
                            @for (int i = 0; i < actividades.Count; i++)
                            {
                                var index = i;
                                var act = actividades[index];
                                @if (act.Id != 0)
                                {
                                    <div class="card mb-3 @(act.Ejecutada ? "border-success" : "border-warning")">
                                        <div class="card-header d-flex justify-content-between align-items-center @(act.Ejecutada ? "bg-success bg-opacity-10" : "bg-warning bg-opacity-10")">
                                            <span>
                                                <i class="bi @(act.Ejecutada ? "bi-check-circle-fill text-success" : "bi-clock text-warning") me-2"></i>
                                                <strong>@act.Descripcion</strong>
                                            </span>
                                            <span class="badge @(act.Ejecutada ? "bg-success" : "bg-warning text-dark")">
                                                @(act.Ejecutada ? "Ejecutada" : "Pendiente")
                                            </span>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-3 mb-2">
                                                    <strong class="d-block text-muted small">Responsable</strong>
                                                    <span>@NombreUsuario(act.ResponsableId)</span>
                                                </div>
                                                <div class="col-md-2 mb-2">
                                                    <strong class="d-block text-muted small">Agencia</strong>
                                                    <span>@act.Agencia</span>
                                                </div>
                                                <div class="col-md-2 mb-2">
                                                    <strong class="d-block text-muted small">Fecha actividad</strong>
                                                    <span>@act.Fecha.ToString("dd/MM/yyyy")</span>
                                                </div>
                                                <div class="col-md-2 mb-2">
                                                    <label class="form-label text-muted small mb-0"><strong>Fecha ejecucion</strong></label>
                                                    <input type="date" class="form-control form-control-sm"
                                                           @bind="actividades[index].FechaEjecucion"
                                                           disabled="@act.Ejecutada"
                                                           min="@fechaInvestigacion.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <label class="form-label text-muted small mb-0"><strong>Ejecutada</strong></label>
                                                    <div class="form-check form-switch mt-1">
                                                        <input class="form-check-input" type="checkbox"
                                                               checked="@act.Ejecutada"
                                                               @onclick="() => SolicitarConfirmacionEjecutada(index)"
                                                               @onclick:preventDefault="true"
                                                               disabled="@act.Ejecutada" />
                                                        <label class="form-check-label">@(act.Ejecutada ? "Si" : "No")</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label text-muted small mb-0"><strong>Observaciones de Seguimiento</strong></label>
                                                    <button type="button" class="btn btn-sm btn-link p-0 ms-2" @onclick="() => ToggleSeguimientosActividad(index)">
                                                        <i class="bi @(actividadExpandidaIndex == index ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                                    </button>

                                                    @if (actividadExpandidaIndex == index)
                                                    {
                                                        <div class="mt-2 border rounded p-2 bg-light">
                                                            <!-- Histórico de observaciones -->
                                                            @{
                                                                var seguimientos = ObtenerSeguimientosActividad(act.Id);
                                                                if (seguimientos.Any())
                                                                {
                                                                    <div class="mb-2">
                                                                        <small class="d-block text-muted fw-bold mb-2">Histórico:</small>
                                                                        <div style="max-height: 150px; overflow-y: auto;">
                                                                            @foreach (var seg in seguimientos)
                                                                            {
                                                                                <div class="border-bottom pb-2 mb-2 small">
                                                                                    <div class="text-muted small">
                                                                                        <strong>@seg.Usuario?.Nombre</strong> - @seg.Fecha.ToString("dd/MM/yyyy HH:mm")
                                                                                    </div>
                                                                                    <div class="mt-1">@seg.Comentario</div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }

                                                            <!-- Agregar nueva observación -->
                                                            @if (!act.Ejecutada)
                                                            {
                                                                <div class="mt-2 pt-2 border-top">
                                                                    <textarea class="form-control form-control-sm" rows="2"
                                                                              @bind="nuevosComentariosActividad[index]"
                                                                              placeholder="Agregar nueva observación..."
                                                                              disabled="@(isLoadingActividad.ContainsKey(index) && isLoadingActividad[index])"></textarea>
                                                                    <button type="button" class="btn btn-sm btn-success mt-2" 
                                                                            @onclick="() => AgregarSeguimientoActividad(act.Id, index)"
                                                                            disabled="@(string.IsNullOrWhiteSpace(nuevosComentariosActividad.ContainsKey(index) ? nuevosComentariosActividad[index] : "") || (isLoadingActividad.ContainsKey(index) && isLoadingActividad[index]))">
                                                                        @if (isLoadingActividad.ContainsKey(index) && isLoadingActividad[index])
                                                                        {
                                                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                                                            <span>Guardando...</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-plus-circle me-1"></i>
                                                                            <span>Agregar</span>
                                                                        }
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label text-muted small mb-0"><strong>Evidencia</strong></label>
                                                    @if (!string.IsNullOrEmpty(act.RutaEvidencia))
                                                    {
                                                        <div class="d-flex align-items-center gap-2 mt-1">
                                                            <a href="/@act.RutaEvidencia" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-file-earmark me-1"></i>@(act.NombreArchivoEvidencia ?? "Ver evidencia")
                                                            </a>
                                                            @if (!act.Ejecutada)
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarEvidencia(index)">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else if (!act.Ejecutada)
                                                    {
                                                        <InputFile class="form-control form-control-sm mt-1"
                                                                   OnChange="(e) => SubirEvidencia(e, index)"
                                                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.zip,.rar" />
                                                        @if (uploadingIndex == index)
                                                        {
                                                            <small class="text-muted"><i class="bi bi-arrow-repeat spin me-1"></i>Subiendo...</small>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small mt-1 d-block">Sin evidencia</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <!-- Modo tabla: edicion o solo lectura -->
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Descripcion</th>
                                            <th>Responsable</th>
                                            <th>Agencia</th>
                                            <th>Fecha</th>
                                            <th>Observaciones</th>
                                            @if (tieneConfirmacionGuardada)
                                            {
                                                <th>Estado</th>
                                                <th>Ejecucion</th>
                                                <th>Evidencia</th>
                                            }
                                            else
                                            {
                                                <th style="width:60px"></th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < actividades.Count; i++)
                                        {
                                            var index = i;
                                            <tr>
                                                @if (tieneConfirmacionGuardada)
                                                {
                                                    <td>@actividades[index].Descripcion</td>
                                                    <td>@NombreUsuario(actividades[index].ResponsableId)</td>
                                                    <td>@actividades[index].Agencia</td>
                                                    <td>@actividades[index].Fecha.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <small>@(string.IsNullOrEmpty(actividades[index].Observaciones) ? "-" : actividades[index].Observaciones)</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(actividades[index].Ejecutada ? "bg-success" : "bg-warning text-dark")">
                                                            @(actividades[index].Ejecutada ? "Ejecutada" : "Pendiente")
                                                        </span>
                                                    </td>
                                                    <td>@(actividades[index].FechaEjecucion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(actividades[index].RutaEvidencia))
                                                        {
                                                            <a href="/@actividades[index].RutaEvidencia" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-file-earmark"></i>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td><input class="form-control form-control-sm" @bind="actividades[index].Descripcion" /></td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="actividades[index].ResponsableId" @bind:after="() => OnResponsableActividadChanged(index)">
                                                            <option value="0">Seleccionar...</option>
                                                            @foreach (var u in usuarios)
                                                            {
                                                                <option value="@u.Id">@u.Nombre</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><input class="form-control form-control-sm" @bind="actividades[index].Agencia" readonly /></td>
                                                    <td><input type="date" class="form-control form-control-sm" @bind="actividades[index].Fecha" @bind:after="() => ValidarFechaActividad(index)" min="@fechaInvestigacion.ToString("yyyy-MM-dd")" max="@fechaCompromiso.ToString("yyyy-MM-dd")" /></td>
                                                    <td><textarea class="form-control form-control-sm" rows="2" @bind="actividades[index].Observaciones" placeholder="Observaciones..."></textarea></td>
                                                    <td>
                                                        @if (puedeEditarActividades)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarActividad(index)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (tieneSolucionGuardada && !tieneConfirmacionGuardada)
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2">
                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Actividades ejecutadas: <strong>@actividades.Count(a => a.Ejecutada)</strong> de <strong>@actividades.Count</strong>
                                    @if (actividades.All(a => a.Ejecutada))
                                    {
                                        <span class="text-success ms-2"><i class="bi bi-check-circle-fill me-1"></i>Todas ejecutadas</span>
                                    }
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted fst-italic">Sin actividades agregadas.</p>
                    }
                </div>
            }
        </div>


        <!-- SEGUIMIENTO SGI (Solo administradores) -->
        @if (esAdmin)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-journal-text me-2"></i>Seguimiento de la mejora</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" @bind="mostrarSeguimientoSgi" />
                        <label class="form-check-label text-white">Mostrar</label>
                    </div>
                </div>
                @if (mostrarSeguimientoSgi)
                {
                    <div class="card-body">
                        <!-- SUBSECCION: Agregar Nuevo Seguimiento -->
                        <div class="border-bottom pb-4 mb-4">
                            <h6 class="mb-3"><i class="bi bi-pencil-square me-2"></i>Agregar Nueva Observación</h6>
                            <div class="row">
                                <div class="col-md-9">
                                    <label class="form-label text-muted small mb-1"><strong>Comentario</strong></label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="nuevoComentarioSgi"
                                              placeholder="Escriba un comentario de seguimiento..."
