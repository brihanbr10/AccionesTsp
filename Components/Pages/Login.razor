@page "/"
@page "/login"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Iniciar Sesion</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-left">
            <div class="auth-illustration">
                <svg viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
                        </linearGradient>
                        <linearGradient id="grad1b" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" style="stop-color:#667eea;stop-opacity:0.2" />
                            <stop offset="100%" style="stop-color:#764ba2;stop-opacity:0.1" />
                        </linearGradient>
                    </defs>

                    <!-- Dashboard background -->
                    <rect x="60" y="60" width="380" height="280" rx="16" fill="#fff" stroke="#e2e8f0" stroke-width="2"/>
                    <rect x="60" y="60" width="380" height="45" rx="16" fill="url(#grad1)"/>
                    <rect x="60" y="89" width="380" height="16" fill="url(#grad1)"/>
                    <!-- Window dots -->
                    <circle cx="85" cy="82" r="6" fill="#fff" opacity="0.5"/>
                    <circle cx="105" cy="82" r="6" fill="#fff" opacity="0.5"/>
                    <circle cx="125" cy="82" r="6" fill="#fff" opacity="0.5"/>

                    <!-- KPI Cards -->
                    <rect x="80" y="120" width="100" height="60" rx="8" fill="#f0f4ff" stroke="#667eea" stroke-width="1.5"/>
                    <rect x="88" y="130" width="40" height="6" rx="3" fill="#667eea" opacity="0.4"/>
                    <text x="88" y="165" font-size="18" font-weight="bold" fill="#667eea">98%</text>

                    <rect x="200" y="120" width="100" height="60" rx="8" fill="#f0fff4" stroke="#48bb78" stroke-width="1.5"/>
                    <rect x="208" y="130" width="40" height="6" rx="3" fill="#48bb78" opacity="0.4"/>
                    <text x="208" y="165" font-size="18" font-weight="bold" fill="#48bb78">124</text>

                    <rect x="320" y="120" width="100" height="60" rx="8" fill="#fffff0" stroke="#ecc94b" stroke-width="1.5"/>
                    <rect x="328" y="130" width="40" height="6" rx="3" fill="#ecc94b" opacity="0.4"/>
                    <text x="328" y="165" font-size="18" font-weight="bold" fill="#d69e2e">15</text>

                    <!-- Bar chart -->
                    <rect x="80" y="200" width="220" height="120" rx="8" fill="#fafbff"/>
                    <rect x="100" y="280" width="24" height="30" rx="4" fill="url(#grad1)" opacity="0.5"/>
                    <rect x="135" y="260" width="24" height="50" rx="4" fill="url(#grad1)" opacity="0.65"/>
                    <rect x="170" y="240" width="24" height="70" rx="4" fill="url(#grad1)" opacity="0.8"/>
                    <rect x="205" y="225" width="24" height="85" rx="4" fill="url(#grad1)"/>
                    <rect x="240" y="250" width="24" height="60" rx="4" fill="url(#grad1)" opacity="0.7"/>
                    <line x1="90" y1="310" x2="280" y2="310" stroke="#e2e8f0" stroke-width="1"/>

                    <!-- Circular progress -->
                    <circle cx="370" cy="260" r="40" fill="none" stroke="#e2e8f0" stroke-width="8"/>
                    <circle cx="370" cy="260" r="40" fill="none" stroke="url(#grad1)" stroke-width="8" stroke-dasharray="200 52" stroke-linecap="round" transform="rotate(-90 370 260)"/>
                    <text x="355" y="266" font-size="16" font-weight="bold" fill="#4a5568">80%</text>

                    <!-- Checklist -->
                    <rect x="80" y="360" width="160" height="110" rx="10" fill="#fff" stroke="#e2e8f0" stroke-width="1.5"/>
                    <rect x="96" y="375" width="12" height="12" rx="3" fill="#48bb78"/>
                    <path d="M99 381 L102 384 L107 378" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                    <rect x="116" y="377" width="80" height="6" rx="3" fill="#e2e8f0"/>
                    <rect x="96" y="397" width="12" height="12" rx="3" fill="#48bb78"/>
                    <path d="M99 403 L102 406 L107 400" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                    <rect x="116" y="399" width="65" height="6" rx="3" fill="#e2e8f0"/>
                    <rect x="96" y="419" width="12" height="12" rx="3" fill="#667eea" opacity="0.3"/>
                    <rect x="116" y="421" width="90" height="6" rx="3" fill="#e2e8f0"/>
                    <rect x="96" y="441" width="12" height="12" rx="3" fill="#667eea" opacity="0.3"/>
                    <rect x="116" y="443" width="55" height="6" rx="3" fill="#e2e8f0"/>

                    <!-- Upward arrow / improvement -->
                    <rect x="270" y="360" width="160" height="110" rx="10" fill="#fff" stroke="#e2e8f0" stroke-width="1.5"/>
                    <polyline points="290,440 320,415 350,425 380,390 410,380" fill="none" stroke="url(#grad1)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <polygon points="405,370 415,382 400,382" fill="url(#grad1)"/>
                    <circle cx="290" cy="440" r="4" fill="#667eea"/>
                    <circle cx="320" cy="415" r="4" fill="#667eea"/>
                    <circle cx="350" cy="425" r="4" fill="#667eea"/>
                    <circle cx="380" cy="390" r="4" fill="#667eea"/>
                    <circle cx="410" cy="380" r="4" fill="#667eea"/>
                </svg>
            </div>
        </div>
        
        <div class="auth-right">
            <h1 class="auth-title">Bienvenido</h1>
            <p class="auth-subtitle">Ingresa tus credenciales para continuar</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-auth alert-danger">
                    <i class="bi bi-exclamation-circle me-2"></i>@errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                <div class="auth-form-group">
                    <label class="auth-label" for="email">Correo electronico</label>
                    <InputText id="email" class="auth-input" @bind-Value="loginModel.Email" placeholder="usuario@ejemplo.com" />
                </div>

                <div class="auth-form-group">
                    <label class="auth-label" for="password">Contrasena</label>
                    <InputText id="password" type="password" class="auth-input" @bind-Value="loginModel.Password" placeholder="********" />
                </div>

                <div class="auth-checkbox">
                    <input type="checkbox" id="remember" @bind="rememberMe" />
                    <label for="remember">Recordar este equipo</label>
                </div>

                <button type="submit" class="auth-btn" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Iniciando sesión...</span>
                    }
                    else
                    {
                        <span>Iniciar sesión</span>
                    }
                </button>
            </EditForm>

            <div class="auth-footer">
                <span>o</span>
                <a href="/register" class="auth-link">Registrarse</a>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool rememberMe = false;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Password))
            {
                errorMessage = "El correo y la contrasena son requeridos.";
                isLoading = false;
                return;
            }

            var result = await AuthService.SignIn(loginModel.Email, loginModel.Password);

            if (result.Success)
            {
                Navigation.NavigateTo("/acciones", forceLoad: true);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex) when (ex.GetType().Name == "NavigationException")
        {
            // Permite la redireccion de Blazor
            throw;
        }
        catch
        {
            errorMessage = "Error al iniciar sesion. Por favor, intenta de nuevo.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
